                          className="w-full bg-surface-container-low border-none rounded-xl p-4 focus:ring-2 focus:ring-brand-clay"
                          placeholder="Your name"
                          type="text"
                        />
                      </div>
                      <div className="flex flex-col gap-2">
                        <label className="font-label-caps text-label-caps text-secondary">Email / Phone</label>
                        <input
                          required
                          value={formData.email}
                          onChange={(e) => setFormData({ ...formData, email: e.target.value })}
                          className="w-full bg-surface-container-low border-none rounded-xl p-4 focus:ring-2 focus:ring-brand-clay"
                          placeholder="How can we reach you?"
                          type="text"
                        />
                      </div>
                    </div>

                    <div className="flex flex-col gap-2">
                      <label className="font-label-caps text-label-caps text-secondary">Inquiry Type</label>
                      <select
                        value={formData.inquiry}
                        onChange={(e) => setFormData({ ...formData, inquiry: e.target.value })}
                        className="w-full bg-surface-container-low border-none rounded-xl p-4 focus:ring-2 focus:ring-brand-clay"
                      >
                        <option>Order Status</option>
                        <option>Custom Artisan Request</option>
                        <option>Upcycled Care</option>
                        <option>Wholesale &amp; Press</option>
                      </select>
                    </div>

                    <div className="flex flex-col gap-2">
                      <label className="font-label-caps text-label-caps text-secondary">Message</label>
                      <textarea
                        required
                        value={formData.message}
                        onChange={(e) => setFormData({ ...formData, message: e.target.value })}
                        className="w-full bg-surface-container-low border-none rounded-xl p-4 focus:ring-2 focus:ring-brand-clay"
                        placeholder="Tell us more about your inquiry..."
                        rows="5"
                      ></textarea>
                    </div>

                    <button
                      className="bg-primary text-on-primary px-8 py-4 rounded-full font-button text-button hover:bg-brand-clay transition-colors duration-300 flex items-center gap-2 cursor-pointer"
                      type="submit"
                    >
                      SEND MESSAGE <span className="material-symbols-outlined text-[18px]">arrow_forward</span>
                    </button>
                  </form>
                </div>

                {/* Right: Studio Info */}
                <div className="lg:col-span-5 bg-surface-container rounded-[32px] p-10 flex flex-col justify-between h-full shadow-sm">
                  <div>
                    <span className="bg-brand-clay/10 text-brand-clay px-3 py-1 rounded-full font-label-caps text-label-caps mb-4 inline-block">
                      STUDIO INFORMATION
                    </span>
                    <div className="space-y-6">
                      <div>
                        <h4 className="font-label-caps text-label-caps text-secondary mb-1">WORKING HOURS</h4>
                        <p className="font-body-lg text-primary font-medium">Mon – Sat: 9:00 AM – 6:00 PM</p>
                      </div>
                      <div>
                        <h4 className="font-label-caps text-label-caps text-secondary mb-1">RESPONSE TIME</h4>
                        <p className="font-body-lg text-primary font-medium">Within 24 hours</p>
                      </div>
                      <div>
                        <h4 className="font-label-caps text-label-caps text-secondary mb-1">CERTIFICATIONS</h4>
                        <p className="font-body-md text-secondary">Proudly meeting OTOP and SACIT standards for Thai artisanal excellence.</p>
                      </div>
                    </div>
                  </div>

                  <div className="pt-8 border-t border-outline-variant/30 mt-8">
                    <h3 className="font-display-lg text-2xl text-brand-clay mb-2">รักธรรมชาติ = รักตัวเอง</h3>
                    <p className="font-body-md text-secondary italic">
                      "To love nature is to love oneself. Our mission is to preserve Thai heritage through sustainable, upcycled craftsmanship."
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </section>

          {/* Integrated FAQs */}
          <FaqSection />

          {/* Integrated Bento Grid */}
          <BentoGridSection />

          <MountainBanner />
          <Footer />
        </div>
      );
    }

    // Scroll to top on route change component
    function ScrollToTop() {
      const { pathname } = useLocation();
      useEffect(() => {
        window.scrollTo(0, 0);
      }, [pathname]);
      return null;
    }

    // App Component
    function App() {
      return (
        <MemoryRouter initialEntries={["/"]}>
          <ScrollToTop />
          <Navbar />
          <Routes>
            <Route path="/" element={<HomePage />} />
            <Route path="/story" element={<StoryPage />} />
            <Route path="/collections" element={<CollectionsPage />} />
            <Route path="/contact" element={<ContactPage />} />
          </Routes>
        </MemoryRouter>
      );
    }

    const container = document.getElementById('root');
    const root = createRoot(container);
    root.render(<App />);
  </script>
</body>
</html>
